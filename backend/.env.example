# ── LLM Providers ─────────────────────────────────────────────────────────────
# OpenAI API key (also sent to LM Studio / Ollama / vLLM, which usually ignore it)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# OpenAI-compatible local server (used when a step's provider is "lmstudio")
# Example for Ollama: http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Default provider + model per step ("openai" | "lmstudio" | "anthropic").
# All of these can also be changed from the Settings page.
PROVIDER_PASS1=openai
PROVIDER_PASS2=openai
MODEL_PASS1=gpt-5.4
MODEL_PASS2=gpt-5.4-mini

# ── Database / server ─────────────────────────────────────────────────────────
# SQLite path (relative to backend/ dir, or absolute)
DATABASE_URL=sqlite+aiosqlite:///./genai_simulator.db
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Execution ─────────────────────────────────────────────────────────────────
# Max concurrent LLM calls
MAX_CONCURRENT_TASKS=10
# Tokens per minute budget (set to your provider tier limit or local model capacity)
TPM_LIMIT=2000000
# Max prompt tokens before the backstory/context is truncated
MAX_CONTEXT_TOKENS=100000
